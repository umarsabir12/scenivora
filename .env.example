# Copy this file to .env and fill in your values. .env is git-ignored; this template is not.
# Development and test only. Production reads real environment variables.

# Required for script and voice generation. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_SPEECH_MODEL=tts-1
# Director: researches the real history on Wikipedia and plans the scene pictures. "off" uses the
# cheap scene planner only.
# OPENAI_DIRECTOR_MODEL=gpt-5.5
# Writes the script from the research; defaults to the Director's model.
# OPENAI_SCRIPT_MODEL=gpt-5.5

# Optional: port for bin/dev (default 3000)
# PORT=3000

# Optional: free Pixabay key for scene images (https://pixabay.com/api/docs/).
# Without it, scenes search Wikimedia Commons only.
PIXABAY_API_KEY=

# Optional: image model for AI scene images (default gpt-image-1-mini, the cheapest listed)
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Optional: credits charged per AI image. Placeholder until pricing is decided.
# CREDITS_PER_AI_IMAGE=5
