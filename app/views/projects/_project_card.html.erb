<li>
  <%= link_to project_path(project),
        class: "group block h-full overflow-hidden rounded-2xl border border-white/5 bg-[#161920] transition hover:-translate-y-0.5 hover:border-white/15" do %>
    <div class="relative h-28 bg-gradient-to-br <%= thumbnail_gradient(project) %>">
      <span class="absolute left-3 top-3 rounded-md bg-black/50 px-2 py-0.5 text-xs font-medium text-white">~<%= project.target_length_minutes %> min</span>
    </div>

    <div class="space-y-3 p-4">
      <h2 class="line-clamp-2 font-semibold group-hover:text-[#f0b95a]"><%= project.title %></h2>

      <div class="flex items-center justify-between gap-3">
        <%= status_badge(project) %>
        <span class="text-xs text-zinc-500"><%= l(project.created_at.to_date, format: :short) %></span>
      </div>
    </div>
  <% end %>
</li>
