<% content_for :title, "#{@project.title} · Scenivora" %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <%= link_to "← Projects", projects_path, class: "text-sm text-zinc-400 hover:text-zinc-200" %>
      <h1 class="mt-2 break-words text-2xl font-semibold tracking-tight"><%= @project.title %></h1>
      <p class="mt-1 text-sm text-zinc-400">
        <%= @project.tone.humanize %> · <%= @project.target_length_minutes %> min · Created <%= l(@project.created_at.to_date, format: :long) %>
      </p>
    </div>

    <%= render "projects/status_badge", project: @project %>
  </header>

  <%= render "projects/wizard", project: @project, current: "Script" %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <section class="rounded-2xl border border-white/5 bg-[#161920] p-6" aria-labelledby="script-heading">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="script-heading" class="text-lg font-semibold">Script</h2>
        <% if (script = @project.latest_script) %>
          <p class="text-sm text-zinc-400">
            <%= number_with_delimiter(script.word_count) %> words · <%= reading_time_label(script.word_count) %>
          </p>
        <% end %>
      </div>

      <p class="mt-3 text-sm text-zinc-400"><span class="text-zinc-300">Prompt:</span> <%= @project.prompt %></p>

      <%= render "projects/script_panel", project: @project %>
    </section>

    <section class="rounded-2xl border border-white/5 bg-[#161920] p-6 lg:sticky lg:top-24 self-start">
      <h2 class="font-semibold">Next: narration voice</h2>
      <p class="mt-1 text-sm text-zinc-400">Choose a voice, generate the narration, and confirm it.</p>

      <div class="mt-4">
        <% if @project.voice_available? %>
          <%= link_to "Go to Voice", project_voice_path(@project), class: "w-full #{button_classes}" %>
        <% else %>
          <p class="text-sm text-zinc-500">Unlocks once the script is ready.</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
