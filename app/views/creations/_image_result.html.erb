<div class="flex flex-wrap items-end gap-3">
  <%= link_to rails_blob_path(creation.file, disposition: "inline"), target: "_blank", rel: "noopener",
        class: "block overflow-hidden rounded-lg border border-white/10" do %>
    <%= image_tag rails_blob_path(creation.file, disposition: "inline"), alt: creation.prompt.truncate(120),
          class: "max-h-56 w-auto", loading: "lazy" %>
  <% end %>
  <div class="flex flex-col gap-2">
    <span class="text-xs text-zinc-500">
      <%= Creation::IMAGE_STYLES[creation.style] %> · <%= Creation::IMAGE_SIZES[creation.size] %> (<%= creation.size %>)
    </span>
    <%= link_to "Download PNG", rails_blob_path(creation.file, disposition: "attachment"), class: small_button_classes %>
  </div>
</div>
