<%# One Create image result: the picture on the left, the prompt and details on the right. %>
<% shown = creation.ready? && creation.file.attached? %>
<div class="flex flex-col gap-4 sm:flex-row" data-controller="lightbox">
  <div class="aspect-[3/2] w-full shrink-0 overflow-hidden rounded-lg border border-white/10 bg-black/40 sm:w-72">
    <% if shown %>
      <button type="button" class="block h-full w-full cursor-zoom-in" title="View full size" data-action="lightbox#open">
        <%= image_tag rails_blob_path(creation.file, disposition: "inline"), alt: creation.prompt.truncate(120),
              class: "h-full w-full object-contain", loading: "lazy" %>
      </button>
    <% elsif creation.failed? %>
      <div class="flex h-full items-center justify-center p-4 text-center text-xs text-zinc-500">No image</div>
    <% else %>
      <div class="flex h-full items-center justify-center text-amber-300"><%= render "scenes/spinner" %></div>
    <% end %>
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-3">
    <p class="text-sm leading-relaxed text-zinc-200"><%= truncate(creation.prompt, length: 400) %></p>

    <ul class="flex flex-wrap gap-1.5 text-xs text-zinc-400" role="list">
      <% [ Creation::IMAGE_STYLES[creation.style],
           "#{Creation::IMAGE_SIZES[creation.size]} · #{creation.size}",
           creation.model&.name,
           (pluralize(creation.credits_charged, "credit") unless creation.failed?) ].compact.each do |detail| %>
        <li class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5"><%= detail %></li>
      <% end %>
    </ul>

    <% if creation.pending? || creation.processing? %>
      <p class="text-sm font-medium text-amber-300" role="status">Generating...</p>
    <% elsif creation.failed? %>
      <p class="text-sm text-red-300" role="alert"><%= creation.error %> <%= "Credits refunded." if creation.credits_charged.positive? %></p>
    <% end %>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-1">
      <span class="text-xs text-zinc-500"><%= time_ago_in_words(creation.created_at) %> ago</span>
      <% if shown %>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="<%= small_button_classes %>" data-action="lightbox#open">View full size</button>
          <%= link_to "Download PNG", rails_blob_path(creation.file, disposition: "attachment"), class: small_button_classes %>
        </div>
      <% end %>
    </div>
  </div>

  <% if shown %>
    <dialog class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/85" aria-label="Full size image"
            data-lightbox-target="dialog" data-action="click->lightbox#close">
      <div class="flex h-dvh w-dvw items-center justify-center p-4 sm:p-8">
        <%= image_tag rails_blob_path(creation.file, disposition: "inline"), alt: creation.prompt.truncate(120),
              class: "max-h-full max-w-full rounded-lg object-contain shadow-2xl", loading: "lazy" %>
      </div>
      <button type="button" class="fixed top-4 right-4 rounded-full bg-black/60 px-3 py-1.5 text-sm font-medium text-zinc-200 hover:bg-black/80"
              aria-label="Close" data-action="lightbox#close">Close</button>
    </dialog>
  <% end %>
</div>
