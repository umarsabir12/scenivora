<% content_for :title, "Choose a new password · Scenivora" %>

<h1 class="text-3xl font-bold tracking-tight">Choose a new password</h1>
<p class="mt-2 text-sm text-zinc-400">You'll be signed in once it's saved.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), method: :put, html: { class: "mt-8 space-y-5" }) do |form| %>
  <%= render "users/shared/error_messages", resource: resource %>
  <%= form.hidden_field :reset_password_token %>

  <div>
    <%= render "users/shared/password_field", form: form, field: :password, label: "New password",
          options: { required: true, autofocus: true, autocomplete: "new-password", placeholder: "At least #{Devise.password_length.min} characters",
                     minlength: Devise.password_length.min, maxlength: Devise.password_length.max } %>
  </div>

  <div>
    <%= render "users/shared/password_field", form: form, field: :password_confirmation, label: "Confirm new password",
          options: { required: true, autocomplete: "new-password", placeholder: "Repeat new password",
                     maxlength: Devise.password_length.max } %>
  </div>

  <%= form.submit "Save new password", class: "#{button_classes} w-full py-2.5" %>
<% end %>
