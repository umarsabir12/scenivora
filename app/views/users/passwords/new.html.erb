<% content_for :title, "Reset password · Scenivora" %>

<h1 class="text-2xl font-bold tracking-tight">Forgot your password?</h1>
<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">We'll email you a link to choose a new one.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), method: :post, class: "mt-6 space-y-5") do |form| %>
  <div>
    <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
          placeholder: "you@example.com", class: field_classes %>
  </div>

  <%= form.submit "Email reset instructions", class: "#{button_classes} w-full" %>
<% end %>

<p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
  <%= link_to "Back to sign in", new_user_session_path, class: "hover:underline" %>
</p>
