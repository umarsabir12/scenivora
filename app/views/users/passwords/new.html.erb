<% content_for :title, "Reset password · Scenivora" %>

<h1 class="text-3xl font-bold tracking-tight">Forgot your password?</h1>
<p class="mt-2 text-sm text-zinc-400">Enter your email and we'll send a link to choose a new one. The link works for 15 minutes.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), method: :post, html: { class: "mt-8 space-y-5" }) do |form| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div>
    <%= form.label :email, "Email", class: "block text-sm font-medium text-zinc-300" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
          placeholder: "you@example.com", class: field_classes %>
  </div>

  <%= form.submit "Email me a reset link", class: "#{button_classes} w-full py-2.5" %>
<% end %>

<p class="mt-8 border-t border-white/5 pt-6 text-center text-sm text-zinc-400">
  <%= link_to "← Back to sign in", new_user_session_path, class: "font-medium text-[#f0b95a] hover:underline" %>
</p>
