<% content_for :title, "Sign in · Scenivora" %>

<h1 class="text-3xl font-bold tracking-tight">Welcome back</h1>
<p class="mt-2 text-sm text-zinc-400">Sign in to pick up your storyboards where you left them.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |form| %>
  <div>
    <%= form.label :email, "Email", class: "block text-sm font-medium text-zinc-300" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
          placeholder: "you@example.com", class: field_classes %>
  </div>

  <div>
    <%= render "users/shared/password_field", form: form, field: :password, label: "Password",
          options: { required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72 } %>
    <div class="mt-2 text-right">
      <%= link_to "Forgot password?", new_user_password_path, class: "text-xs text-zinc-400 hover:text-[#f0b95a]" %>
    </div>
  </div>

  <label class="flex items-center gap-2 text-sm text-zinc-400">
    <%= form.check_box :remember_me, class: "size-4 rounded accent-[#f0b95a]" %>
    Keep me signed in
  </label>

  <%= form.submit "Sign in", class: "#{button_classes} w-full py-2.5" %>
<% end %>

<p class="mt-8 border-t border-white/5 pt-6 text-center text-sm text-zinc-400">
  New to Scenivora?
  <%= link_to "Create an account", new_user_registration_path, class: "font-medium text-[#f0b95a] hover:underline" %>
</p>
