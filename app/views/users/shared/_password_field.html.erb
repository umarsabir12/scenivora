<%# A password field with a Show/Hide button. Locals: form, field, label, and any field options. %>
<div data-controller="password-visibility">
  <%= form.label field, label, class: "block text-sm font-medium text-zinc-300" %>
  <div class="relative">
    <%= form.password_field field, **options, class: "#{field_classes} pr-16", data: { password_visibility_target: "input" } %>
    <button type="button" class="absolute inset-y-0 right-0 mt-1 px-3 text-xs font-medium text-zinc-400 hover:text-zinc-100 cursor-pointer"
            data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Show password">Show</button>
  </div>
</div>
