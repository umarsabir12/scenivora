<% content_for :title, "Create account · Scenivora" %>

<h1 class="text-3xl font-bold tracking-tight">Make your first video</h1>
<p class="mt-2 text-sm text-zinc-400">Create an account, type a topic, and get a storyboard in about 10 minutes.</p>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |form| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div>
    <%= form.label :email, "Email", class: "block text-sm font-medium text-zinc-300" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
          placeholder: "you@example.com", class: field_classes %>
  </div>

  <div>
    <%= render "users/shared/password_field", form: form, field: :password, label: "Password",
          options: { required: true, autocomplete: "new-password", placeholder: "At least #{Devise.password_length.min} characters",
                     minlength: Devise.password_length.min, maxlength: Devise.password_length.max } %>
  </div>

  <div>
    <%= render "users/shared/password_field", form: form, field: :password_confirmation, label: "Confirm password",
          options: { required: true, autocomplete: "new-password", placeholder: "Repeat your password",
                     maxlength: Devise.password_length.max } %>
  </div>

  <%= form.submit "Create account", class: "#{button_classes} w-full py-2.5" %>
  <p class="text-center text-xs text-zinc-500">Your videos stay private. You upload them to YouTube yourself.</p>
<% end %>

<p class="mt-8 border-t border-white/5 pt-6 text-center text-sm text-zinc-400">
  Already have an account?
  <%= link_to "Sign in", new_user_session_path, class: "font-medium text-[#f0b95a] hover:underline" %>
</p>
