<%# Progress of "Create video". The job refreshes the page at each step and when it's done. %>
<section class="space-y-4 rounded-2xl border border-amber-400/30 bg-amber-400/5 p-6" role="status" aria-live="polite">
  <div>
    <h2 class="text-lg font-semibold text-amber-200">Creating your video</h2>
    <p class="mt-1 text-sm text-zinc-400">This takes about 5 to 10 minutes. You can leave this page and come back.</p>
  </div>
  <ol class="space-y-2 text-sm">
    <% production_steps(project).each do |label, state| %>
      <li class="flex items-center gap-3 <%= { done: "text-emerald-300", current: "font-medium text-amber-200", waiting: "text-zinc-500" }[state] %>">
        <% if state == :current %>
          <%= render "scenes/spinner" %>
        <% elsif state == :done %>
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        <% else %>
          <span class="size-4 rounded-full border border-white/15" aria-hidden="true"></span>
        <% end %>
        <span><%= label %><span class="sr-only"> (<%= state %>)</span></span>
      </li>
    <% end %>
  </ol>
</section>
