<% content_for :title, "Music · #{@project.title} · Scenivora" %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <%= link_to "← #{@project.title}", project_path(@project), class: "block max-w-xl truncate text-sm text-zinc-400 hover:text-zinc-200" %>
    </div>
    <%= render "projects/status_badge", project: @project %>
  </header>

  <%= render "projects/wizard", project: @project, current: "Music" %>

  <section class="rounded-2xl border border-dashed border-white/10 bg-[#161920] px-6 py-16 text-center">
    <h2 class="text-lg font-semibold">Music is the next step</h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-zinc-400">
      Your scenes are approved. This step will add background music under the narration. It isn't built yet.
    </p>
    <%= link_to "Back to scenes", project_scenes_path(@project), class: "mt-6 inline-flex #{secondary_button_classes}" %>
  </section>
</div>
