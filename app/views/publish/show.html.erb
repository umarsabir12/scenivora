<% content_for :title, "Publish · #{@project.title} · Scenivora" %>
<%= turbo_stream_from @project, :publish %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <%= link_to "← #{@project.title}", project_path(@project), class: "block max-w-xl truncate text-sm text-zinc-400 hover:text-zinc-200" %>
    </div>
    <%= render "projects/status_badge", project: @project %>
  </header>

  <%= render "projects/wizard", project: @project, current: "Publish" %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <section class="min-w-0 space-y-4" aria-labelledby="ready-heading">
      <h2 id="ready-heading" class="text-2xl font-semibold tracking-tight">Your video is ready</h2>

      <video controls preload="metadata" class="aspect-video w-full rounded-2xl bg-black"
             src="<%= rails_blob_path(@project.video, disposition: "inline") %>"
             <% if @project.thumbnail.attached? %>poster="<%= rails_blob_path(@project.thumbnail, disposition: "inline") %>"<% end %>></video>

      <div class="flex flex-wrap gap-3">
        <%= link_to "Download MP4 · 1080p", rails_blob_path(@project.video, disposition: "attachment"), class: button_classes %>
        <% if @project.thumbnail.attached? %>
          <%= link_to "Download thumbnail", rails_blob_path(@project.thumbnail, disposition: "attachment"), class: secondary_button_classes %>
        <% end %>
        <%= link_to "Download captions (.srt)", captions_project_publish_path(@project), class: secondary_button_classes %>
        <%= link_to "Re-render", project_render_path(@project), class: secondary_button_classes %>
      </div>
      <p class="text-xs text-zinc-500">
        Upload the .srt in YouTube Studio under Subtitles, so viewers can turn captions on and search can read them.
        <% if Captions::WordTimings.new(@project.voice_track, @project.latest_script).approximate? %>
          This narration was made before paragraph timing existed, so caption timing is approximate.
          Regenerating the voice makes it accurate.
        <% end %>
      </p>

      <% voice = @project.voice_track %>
      <% music = @project.music_track if @project.music_track&.ready? %>
      <dl class="grid gap-3 text-sm sm:grid-cols-2">
        <div class="rounded-xl border border-white/5 bg-[#161920] p-4">
          <dt class="text-xs uppercase tracking-wide text-zinc-500">Voice</dt>
          <dd class="mt-1 text-zinc-200"><%= voice.voice_name.capitalize %> · <%= format("%.2f", voice.speed) %>x</dd>
        </div>
        <div class="rounded-xl border border-white/5 bg-[#161920] p-4">
          <dt class="text-xs uppercase tracking-wide text-zinc-500">Music</dt>
          <dd class="mt-1 truncate text-zinc-200"><%= music ? "#{music.title} · #{music.volume}%" : "None" %></dd>
        </div>
      </dl>
    </section>

    <aside class="self-start space-y-4 rounded-2xl border border-white/5 bg-[#161920] p-5 lg:sticky lg:top-24" aria-labelledby="details-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="details-heading" class="text-lg font-semibold">YouTube details</h2>
        <% unless @project.settings["metadata_generating"] %>
          <%= button_to (@project.yt_title.present? ? "Regenerate" : "Write details"), generate_project_publish_path(@project),
                method: :post, class: small_button_classes,
                title: "Estimated cost: $#{format("%.4f", Ai::MetadataGenerator.estimated_cost(@project.latest_script&.body.to_s))}",
                form: { data: { turbo_confirm: (@project.yt_title.present? ? "Replace the current details with new ones?" : nil) } } %>
        <% end %>
      </div>

      <% if @project.settings["metadata_generating"] %>
        <p class="flex items-center gap-3 rounded-xl border border-dashed border-amber-400/40 bg-amber-400/5 p-4 text-sm font-medium text-amber-300" role="status">
          <%= render "scenes/spinner" %>
          Writing the title, description and tags...
        </p>
      <% end %>
      <% if @project.settings["metadata_error"] %>
        <p class="rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-300" role="alert"><%= @project.settings["metadata_error"] %></p>
      <% end %>

      <%= form_with model: @project, url: project_publish_path(@project), method: :patch, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :yt_title, "Title", class: "block text-xs font-medium uppercase tracking-wide text-zinc-500" %>
          <%= form.text_field :yt_title, maxlength: Ai::MetadataGenerator::MAX_TITLE, class: field_classes %>
        </div>
        <div>
          <%= form.label :yt_description, "Description", class: "block text-xs font-medium uppercase tracking-wide text-zinc-500" %>
          <%= form.text_area :yt_description, rows: 9, maxlength: 5_000, class: "#{field_classes} text-sm" %>
          <p class="mt-1 text-xs text-zinc-500">Credits and AI disclosures are added under the description automatically.</p>
        </div>
        <div>
          <%= form.label :yt_tags, "Tags (comma-separated)", class: "block text-xs font-medium uppercase tracking-wide text-zinc-500" %>
          <%= form.text_field :yt_tags, value: @project.yt_tags.join(", "), class: field_classes %>
        </div>
        <div>
          <%= form.label :yt_category, "Category", class: "block text-xs font-medium uppercase tracking-wide text-zinc-500" %>
          <%= form.select :yt_category, Ai::MetadataGenerator::CATEGORIES, { include_blank: "Choose a category" }, class: field_classes %>
        </div>
        <%= form.submit "Save details", class: "#{secondary_button_classes} w-full" %>
      <% end %>

      <div data-controller="clipboard">
        <textarea data-clipboard-target="source" class="sr-only" aria-hidden="true" tabindex="-1" readonly><%= youtube_details_text(@project) %></textarea>
        <button type="button" data-clipboard-target="button" data-action="clipboard#copy"
                class="<%= button_classes %> w-full" <%= "disabled" if @project.yt_title.blank? %>>Copy all details</button>
      </div>

      <p class="rounded-xl border border-white/5 p-3 text-center text-xs text-zinc-500">One-click YouTube upload: coming soon</p>
    </aside>
  </div>
</div>
