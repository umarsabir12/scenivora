<% content_for :title, "Voice · #{@project.title} · Scenivora" %>
<%= turbo_stream_from @project, :voice %>

<div class="mx-auto max-w-5xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <%= link_to "← #{@project.title}", project_path(@project), class: "block max-w-xl truncate text-sm text-zinc-400 hover:text-zinc-200" %>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Voice</h1>
    </div>
    <%= render "projects/status_badge", project: @project %>
  </header>

  <%= render "projects/wizard", project: @project, current: "Voice" %>

  <section class="rounded-2xl border border-white/5 bg-[#161920] p-6" aria-labelledby="generated-heading">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="generated-heading" class="text-lg font-semibold">Generated voice</h2>
      <% if @track.persisted? && @track.confirmed? %>
        <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-300">Confirmed</span>
      <% end %>
    </div>

    <%= render "voices/panel", project: @project, track: @track, progress: nil %>

    <% if @track.persisted? && @track.ready? %>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-white/5 pt-5">
        <p class="text-sm text-zinc-400">
          <% if @track.confirmed? %>
            Confirmed. Regenerating the voice clears this confirmation.
          <% elsif @track.stale_for?(@project.latest_script) %>
            Regenerate the voice before confirming, because the script changed.
          <% else %>
            Confirm this voice to lock it in for the next steps.
          <% end %>
        </p>

        <% if !@track.confirmed? && !@track.stale_for?(@project.latest_script) %>
          <%= button_to "Confirm voice", confirm_project_voice_path(@project), method: :post, class: button_classes %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-white/5 bg-[#161920] p-6" aria-labelledby="narration-heading">
    <h2 id="narration-heading" class="text-lg font-semibold">Narration voice</h2>
    <%= render "voices/picker", project: @project, track: @track, samples: @samples %>
  </section>
</div>
