<%= form_with model: track, url: project_voice_path(project), method: :post, class: "mt-5 space-y-6",
      data: { controller: "range-output" } do |form| %>
  <fieldset>
    <legend class="text-xs font-medium uppercase tracking-wide text-zinc-500">Voice</legend>

    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% Ai::SpeechGenerator::VOICES.each do |name, description| %>
        <label class="flex min-w-0 cursor-pointer flex-col gap-3 rounded-xl border border-white/10 p-4 has-[:checked]:border-amber-400/60 has-[:checked]:bg-amber-400/5">
          <span class="flex items-start gap-3">
            <%= form.radio_button :voice_name, name, class: "mt-1 size-4 shrink-0 accent-amber-400" %>
            <span class="min-w-0">
              <span class="block font-medium capitalize"><%= name %></span>
              <span class="block text-xs text-zinc-500"><%= description %></span>
            </span>
          </span>

          <span id="voice_sample_<%= name %>" class="block">
            <%= render "voice_samples/sample", voice_name: name, sample: samples[name] %>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium uppercase tracking-wide text-zinc-500">Speed</span>
        <output data-range-output-target="output" class="text-sm font-medium text-amber-300"><%= format("%.2f", track.speed || 1.0) %>x</output>
      </div>
      <%= form.range_field :speed, min: 0.85, max: 1.15, step: 0.05, value: (track.speed || 1.0),
            class: "mt-3 w-full accent-amber-400",
            data: { range_output_target: "input", action: "input->range-output#update" } %>
      <p class="mt-2 text-xs text-zinc-500">Previews follow this speed. The narration uses it when generated.</p>
    </div>

    <div class="rounded-xl border border-white/5 bg-white/[0.03] p-4 text-sm">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Estimated cost for this step</p>
      <p class="mt-1 font-medium text-zinc-200"><%= voice_cost_estimate(project.latest_script) %></p>
    </div>
  </div>

  <div class="flex justify-end">
    <%= form.submit(track.persisted? ? "Regenerate voice" : "Generate voice", class: button_classes) %>
  </div>
<% end %>
