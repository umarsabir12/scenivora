<%# Replaced live over Turbo Streams while the job runs. Contains no forms: a CSRF token rendered here would not match the viewer's session. %>
<div id="voice_panel" class="space-y-4">
  <% if track.processing? || track.pending? %>
    <div class="flex items-center gap-3 rounded-xl border border-dashed border-amber-400/40 bg-amber-400/5 p-4" role="status">
      <svg class="size-5 shrink-0 animate-spin text-amber-300" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
      <p class="text-sm font-medium text-amber-200"><%= local_assigns[:progress] || "Starting..." %></p>
    </div>
  <% elsif track.failed? %>
    <div class="space-y-3 rounded-xl border border-red-500/30 bg-red-500/10 p-4" role="alert">
      <p class="text-sm font-medium text-red-300"><%= track.error.presence || "Voice generation failed." %></p>
      <%= link_to "Retry", project_voice_path(project), class: secondary_button_classes, data: { turbo_method: :post } %>
    </div>
  <% end %>

  <% if track.persisted? && track.file.attached? %>
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Narration</p>
      <audio controls preload="metadata" class="w-full" src="<%= rails_blob_path(track.file, disposition: "inline") %>"></audio>
      <p class="text-sm text-zinc-400">
        <%= duration_label(track.duration_ms.to_i) %> · <%= track.voice_name.capitalize %> at <%= format("%.2f", track.speed) %>x
      </p>
    </div>

    <% if track.stale_for?(project.latest_script) %>
      <div class="space-y-3 rounded-xl border border-amber-400/30 bg-amber-400/10 p-4">
        <p class="text-sm font-medium text-amber-200">Script changed since voice was generated — regenerate voice?</p>
        <%= link_to "Regenerate", project_voice_path(project), class: secondary_button_classes, data: { turbo_method: :post } %>
      </div>
    <% end %>
  <% elsif track.new_record? %>
    <p class="text-sm text-zinc-500">No narration yet. Choose a voice and generate it.</p>
  <% end %>
</div>
